{
	"name": "1on2-reserve",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "vite build",
		"preview": "vite build && vite preview",
		"deploy": "vite build && wrangler deploy",
		"test": "bun --env-file=.dev.vars.test test",
		"typecheck": "tsc -b",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"cf-typegen": "wrangler types",
		"db:generate": "bun --env-file=.dev.vars drizzle-kit generate",
		"db:migrate": "bun --env-file=.dev.vars drizzle-kit migrate",
		"db:studio": "bun --env-file=.dev.vars drizzle-kit studio"
	},
	"dependencies": {
		"@hono/zod-validator": "^0.9.1",
		"@neondatabase/serverless": "^1.2.0",
		"@tanstack/react-query": "^5.104.0",
		"better-auth": "^1.7.12",
		"drizzle-orm": "^0.45.3",
		"hono": "^4.13.12",
		"react": "^19.3.0",
		"react-dom": "^19.3.0",
		"react-router": "^8.4.0",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.15",
		"@cloudflare/vite-plugin": "^1.62.4",
		"@tailwindcss/vite": "^4.3.3",
		"@types/bun": "^1.4.2",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.1.1",
		"drizzle-kit": "^0.31.11",
		"tailwindcss": "^4.3.3",
		"typescript": "^7.0.2",
		"vite": "^8.3.2",
		"wrangler": "^4.146.0"
	}
}
