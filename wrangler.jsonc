{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "1on2-reserve",
	"main": "src/worker/index.ts",
	"compatibility_date": "2026-10-01",
	"compatibility_flags": ["nodejs_compat"],
	"assets": {
		"not_found_handling": "single-page-application",
		"run_worker_first": ["/api/*"]
	},
	// 本番の入口を aix-hub.yuu0413.com だけにする。better-auth は BETTER_AUTH_URL の URL でしかログインを完了できず、
	// workers.dev の URL を残すとログインできない入口が公開されたままになるため。
	// DNS レコードと証明書は、デプロイ時に Cloudflare が作る（yuu0413.com が同じアカウントにある必要がある）
	"workers_dev": false,
	"routes": [{ "pattern": "aix-hub.yuu0413.com", "custom_domain": true }],
	"observability": {
		"enabled": true
	},
	// Cron は UTC で書く。15:05 UTC = 日本時間の毎日 0:05（処理は src/worker/cron.ts）。
	// 日付は起動する予定だった時刻で決めるため、日本時間で日付が変わった後なら何時でもよい
	"triggers": {
		"crons": ["5 15 * * *"]
	}
}
